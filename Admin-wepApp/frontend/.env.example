# Firebase Console → Project settings → General → Your apps → Web app config
# Copy into .env (same folder as package.json). Never commit .env.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=ecodrone-dev.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://ecodrone-dev-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=ecodrone-dev
VITE_FIREBASE_STORAGE_BUCKET=ecodrone-dev.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Local dev only: if you cannot log in via the real API (no session cookie), set true to view /dashboard/* without redirect to login. Never use in production builds.
# VITE_SKIP_DASHBOARD_AUTH=true
