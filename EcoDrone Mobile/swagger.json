    - price
    - description
    type: object
    properties:
      id:
        title: ID
        type: integer
        readOnly: true
      name:
        title: Name
        type: string
        maxLength: 255
        minLength: 1
      price:
        title: Price
        type: string
        format: decimal
      description:
        title: Description
        type: string
        minLength: 1
      image_url:
        title: Image url
        type: string
        format: uri
        maxLength: 500
        x-nullable: true
      category_id:
        title: Category id
        type: integer
        x-nullable: true
      vendor_id:
        title: Vendor id
        type: integer
        x-nullable: true
      status:
        title: Status
        type: string
        readOnly: true
        minLength: 1
      date_added:
        title: Date added
        type: string
        format: date-time
        readOnly: true
